{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JavaBoot Launcher",
  "version": "0.18.2",
  "identifier": "com.javaboot.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && cargo build --release --manifest-path src-tauri/Cargo.toml -p javaboot-daemon"
  },
  "app": {
    "windows": [
      {
        "title": "JavaBoot Launcher",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://node-red.gyfwork.cc.cd",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "target/release/javaboot-daemon.exe": "resources/javaboot-daemon.exe"
    }
  },
  "plugins": {}
}
