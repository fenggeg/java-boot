{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认权限：仅允许应用实际使用的核心能力",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:webview:default",
    "core:window:default",
    "core:window:allow-scale-factor",
    "core:window:allow-set-focus",
    "core:app:default",
    "dialog:default",
    "opener:default"
  ]
}
